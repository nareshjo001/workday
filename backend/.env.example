# Server
PORT=5000
NODE_ENV=development
STARTUP_DB_RETRIES=30
STARTUP_DB_RETRY_MS=1000

# CORS
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=vms_db
# Local test runs reuse these credentials but override DB_NAME to vms_test.
# Never place production credentials in this file.

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# M02 sessions and transactional email. Configure SMTP in deployed environments.
REFRESH_TOKEN_EXPIRES_DAYS=14
ACTION_TOKEN_EXPIRES_MINUTES=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
PUBLIC_APP_URL=http://localhost:5173
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Module 6: invoices generated below this amount are AUTO_APPROVED;
# at or above it, a PM must manually review them.
INVOICE_AUTO_APPROVAL_THRESHOLD=10000

# Persistent document/PDF storage. In Compose this is /app/uploads/documents.
DOCUMENT_STORAGE_PATH=uploads/documents
UPLOAD_MAX_BYTES=5242880
LOG_LEVEL=info
# Demo data is deliberately opt-in and never enabled in production.
DEMO_SEED_ENABLED=false
