{
  "name": "vms-backend",
  "version": "1.0.0",
  "description": "Vendor Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/run.js",
    "test": "node --test --test-concurrency=1 test/integration/legacy-regressions.test.js",
    "test:coverage": "c8 --all --check-coverage --lines 40 --functions 40 --branches 30 --include \"src/services/**\" --include \"src/repositories/**\" node --test --test-concurrency=1 test/integration/legacy-regressions.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
