{
  "name": "vms-backend",
  "version": "1.0.0",
  "description": "Vendor Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/run.js",
    "migrate:baseline": "node src/migrations/run.js --baseline-existing",
    "migrate:status": "node -e \"require('./src/config/db').pool.query('SELECT filename, applied_at FROM schema_migrations ORDER BY filename').then(([r])=>console.table(r)).finally(()=>require('./src/config/db').pool.end())\"",
    "seed:demo": "node scripts/seedDemo.js",
    "reminders:run": "node scripts/runReminders.js",
    "test": "node --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "test:coverage": "c8 --all --check-coverage --lines 40 --functions 40 --branches 30 --include \"src/services/**\" --include \"src/repositories/**\" --include \"src/observability/**\" node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.0.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
